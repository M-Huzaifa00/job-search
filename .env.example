# Copy to .env and adjust. Every variable is optional; the values shown are the defaults.

# --- Server ---------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
# NODE_ENV=production

# --- Persistence (SQLite, built into Node) --------------------------------
# DATABASE_URL accepts "sqlite:./data/jobs.db" or a plain path; DATABASE_PATH wins if both are set.
DATABASE_URL=sqlite:./data/jobs.db
PERSIST=true

# --- Concurrency, timeouts, retries -----------------------------------------
MAX_CONCURRENCY=6
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=3
# Longest Retry-After (ms) we will wait on an HTTP 429 before giving up on that request.
MAX_RETRY_AFTER_MS=60000
# Hard cap for a whole run; partial results are returned when it is hit.
RUN_TIMEOUT_MS=900000

# --- Search limits ------------------------------------------------------------
MAX_PAGES_PER_KEYWORD=3
MAX_RESULTS_PER_SOURCE=600
MAX_RESULTS_PER_KEYWORD=100
DEFAULT_HOURS_OLD=24

# --- Enrichment / validation --------------------------------------------------
# Fetch job-detail pages for candidates that pass the cheap pre-screen.
FETCH_DETAILS=true
MAX_DETAILS_PER_SOURCE=150
# off | redirects (follow aggregator click-trackers, reject Indeed destinations) | all (also check employer URLs)
VALIDATE_URLS=redirects
MAX_URL_VALIDATIONS=200
# Keep listings whose posting date cannot be determined (sorted last, date_confidence=unknown).
INCLUDE_UNDATED=true
# Drop LinkedIn-style reposts whose "company" is an aggregator (Lensa, Jobs via Dice, Jobgether, ...).
EXCLUDE_REPOST_AGGREGATORS=true

# --- Caching --------------------------------------------------------------------
SEARCH_CACHE_TTL_MS=600000
DETAIL_CACHE_TTL_HOURS=24

# --- Sources ----------------------------------------------------------------------
# Comma-separated ids. ENABLED_SOURCES replaces the default set; DISABLED_SOURCES removes from it.
# ids: linkedin, dice, remoteok, remotive, jobicy, careerjet, jooble, canada_job_bank, simplyhired,
#      ziprecruiter, glassdoor, careerbuilder, monster, wellfound, builtin
# ENABLED_SOURCES=linkedin,dice,remoteok,remotive,jobicy,careerjet,jooble,canada_job_bank
# DISABLED_SOURCES=canada_job_bank

# SimplyHired is operated by Indeed ("part of the Indeed Site"); it is off unless you opt in.
ALLOW_INDEED_NETWORK_SOURCES=false
# When a blocked source is requested explicitly, make one probe request and report what it returned.
PROBE_BLOCKED_SOURCES=true

# Per-source overrides: SOURCE_CONCURRENCY_<ID>, SOURCE_MIN_INTERVAL_MS_<ID>
# SOURCE_CONCURRENCY_LINKEDIN=2
# SOURCE_MIN_INTERVAL_MS_LINKEDIN=1500

# --- Source credentials (never commit real keys) ---------------------------------
# Jooble official API key: https://jooble.org/api/about
JOOBLE_API_KEY=
# JOOBLE_API_HOST=jooble.org
# CareerJet affiliate id (optional but recommended): https://www.careerjet.com/partners/
CAREERJET_AFFID=
# CareerJet's API requires a Referer identifying the calling page.
CAREERJET_REFERER=http://localhost/medical-remote-job-aggregator

# --- HTTP client --------------------------------------------------------------------
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
# Optional outbound proxy, e.g. http://user:pass@proxy.example.com:8080 (credentials are redacted in logs)
PROXY_URL=

# --- Logging / output --------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=pretty
# Prefix CSV files with a UTF-8 BOM so Excel detects the encoding.
CSV_BOM=true
